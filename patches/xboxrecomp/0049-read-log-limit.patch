Log file reads only until 2000, then failures

Every NtReadFile printed and flushed a line. Jedi Starfighter reads
common.pak a byte at a time: half a million lines, a 33 MB log and a
slow start-up. The first 2000 reads are still logged, then only reads
that fail or come up short.

--- a/src/kernel/kernel_bridge.c
+++ b/src/kernel/kernel_bridge.c
@@ -3766,6 +3766,15 @@
     {
         const uint8_t *p = (const uint8_t *)XBOX_TO_NATIVE(buffer_va);
         uint32_t got = (uint32_t)ios.Information;
+        /* The first 2000 reads, then only those that fail or come up short:
+         * a title reading a file a byte at a time (Jedi Starfighter's
+         * common.pak, half a million reads) otherwise fills the log and
+         * spends its start-up flushing it. */
+        static volatile long reads_logged;
+        if (++reads_logged > 2000 && ios.Status == STATUS_SUCCESS && got == length)
+            goto read_logged;
+        if (reads_logged == 2001)
+            fprintf(stderr, "  [READ] ...: further reads logged only when they fail or come up short\n");
         /* The offset matters as much as the length. A title streaming a pack
          * file reads sector-aligned chunks, so the first bytes belong to
          * whatever precedes the file it actually wants, and a read that stops
@@ -3786,6 +3795,7 @@
                     got > 2 ? p[2] : 0, got > 3 ? p[3] : 0);
         fflush(stderr);
     }
+read_logged:
     bridge_write_iostatus(iostatus, ios.Status, (uint32_t)ios.Information);
     bridge_complete_file_io(STACK_ARG(1), STACK_ARG(2), STACK_ARG(3),
                             iostatus);
